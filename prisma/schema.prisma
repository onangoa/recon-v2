generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  role          String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  activityLogs  ActivityLog[]
  contractor    Contractor?
  notifications Notification[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contractor {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  companyName             String
  location                String
  phoneNumber             String
  licenseNo               String
  subscriptionPlanId      String
  subscriptionStatus      String                   @default("active")
  subscriptionEndDate     DateTime?
  safetyScore             Float                    @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activityLogs            ActivityLog[]
  subscriptionPlan        SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designations            Designation[]
  notificationPreferences NotificationPreference[]
  payrollPeriods          PayrollPeriod[]
  salaryComponents        SalaryComponent[]
  salarySlips             SalarySlip[]
  sites                   Site[]
  shifts                  Shift[]
  attendances             Attendance[]
  team                    TeamMember[]
  workers                 Worker[]

  @@index([subscriptionPlanId])
}

model Worker {
  id                    String          @id @default(cuid())
  contractorId          String
  name                  String
  email                 String?
  phone                 String?
  nationalId            String?         @unique
  designationId         String?
  shiftId               String?
  status                String          @default("Active")
  joinedAt              DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  payrollPeriodsCreated PayrollPeriod[] @relation("CreatedBy")
  salarySlips           SalarySlip[]
  designation           Designation?    @relation(fields: [designationId], references: [id])
  shift                 Shift?          @relation(fields: [shiftId], references: [id])
  attendances           Attendance[]
  contractor            Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([designationId])
  @@index([shiftId])
}

model Shift {
  id            String       @id @default(cuid())
  contractorId  String
  name          String
  startTime     String // e.g., "08:00"
  endTime       String // e.g., "17:00"
  breakDuration Float        @default(0) // in minutes
  workingDays   String // comma separated: "Monday,Tuesday,Wednesday,Thursday,Friday"
  allowOvertime Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  contractor    Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workers       Worker[]
  attendances   Attendance[]

  @@index([contractorId])
}

model Attendance {
  id            String     @id @default(cuid())
  contractorId  String
  workerId      String
  shiftId       String?
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  totalHours    Float      @default(0)
  overtimeHours Float      @default(0)
  status        String     @default("Present") // Present, Absent, Late, Leave
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  worker        Worker     @relation(fields: [workerId], references: [id], onDelete: Cascade)
  shift         Shift?     @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([contractorId])
  @@index([workerId])
  @@index([shiftId])
}

model Designation {
  id               String       @id @default(cuid())
  contractorId     String
  title            String
  description      String?
  salary           Float?
  paymentFrequency String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  contractor       Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  salarySlips      SalarySlip[]
  workers          Worker[]

  @@index([contractorId])
}

model PayrollPeriod {
  id                String       @id @default(cuid())
  contractorId      String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            String       @default("draft")
  description       String?
  totalEmployees    Int          @default(0)
  totalGrossPay     Float        @default(0)
  totalNetPay       Float        @default(0)
  totalDeductions   Float        @default(0)
  createdByWorkerId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  paymentFrequency  String?      @default("monthly")
  createdBy         Worker?      @relation("CreatedBy", fields: [createdByWorkerId], references: [id])
  contractor        Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  salarySlips       SalarySlip[]

  @@index([contractorId])
  @@index([createdByWorkerId])
}

model SalaryComponent {
  id              String     @id @default(cuid())
  contractorId    String
  name            String
  type            String
  deductionType   String?
  calculationType String
  amount          Float?
  percentage      Float?
  isTaxable       Boolean    @default(true)
  isStatutory     Boolean    @default(false)
  isActive        Boolean    @default(true)
  description     String?
  sortOrder       Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model SalarySlip {
  id               String             @id @default(cuid())
  contractorId     String
  payrollPeriodId  String
  workerId         String
  designationId    String?
  workingHours     Float              @default(0)
  attainedHours    Float              @default(0)
  workingDays      Int                @default(0)
  attainedDays     Int                @default(0)
  overtimeHours    Float              @default(0)
  lateHours        Float              @default(0)
  lateDays         Int                @default(0)
  leaveHours       Float              @default(0)
  leaveDays        Int                @default(0)
  basicSalary      Float              @default(0)
  totalAllowance   Float              @default(0)
  totalDeductions  Float              @default(0)
  grossPay         Float              @default(0)
  chargeableIncome Float              @default(0)
  payeTax          Float              @default(0)
  personalRelief   Float              @default(0)
  netPay           Float              @default(0)
  employerCosts    Float              @default(0)
  status           String             @default("draft")
  note             String?
  paymentMethod    String?
  phoneNumber      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  designation      Designation?       @relation(fields: [designationId], references: [id])
  worker           Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  payrollPeriod    PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  contractor       Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  details          SalarySlipDetail[]

  @@index([contractorId])
  @@index([payrollPeriodId])
  @@index([workerId])
  @@index([designationId])
}

model SalarySlipDetail {
  id                 String     @id @default(cuid())
  salarySlipId       String
  salaryComponentId  String
  componentName      String
  componentType      String
  deductionType      String?
  isStatutory        Boolean    @default(false)
  amount             Float      @default(0)
  percentage         Float?
  calculationDetails String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  salarySlip         SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
  @@index([salaryComponentId])
}

model SubscriptionPlan {
  id             String       @id @default(cuid())
  name           String       @unique
  price          Float
  maxSites       Int
  maxTeamMembers Int
  features       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contractors    Contractor[]
}

model Site {
  id             String           @id @default(cuid())
  contractorId   String
  name           String
  location       String
  description    String?
  isPrimary      Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  documents      Document[]
  equipment      Equipment[]
  licenses       License[]
  materials      Material[]
  metrics        Metric[]
  purchaseOrders PurchaseOrder[]
  incidents      SafetyIncident[]
  contractor     Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  tasks          Task[]
  visitors       Visitor[]

  @@index([contractorId])
}

model TeamMember {
  id           String     @id @default(cuid())
  contractorId String
  name         String
  role         String
  email        String?
  phone        String?
  status       String     @default("Active")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model Task {
  id          String    @id @default(cuid())
  siteId      String
  title       String
  description String?
  status      String
  priority    String
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([status])
}

model Material {
  id            String             @id @default(cuid())
  siteId        String
  name          String
  description   String?
  sku           String?
  barcode       String?
  categoryId    String?
  quantity      Float
  unit          String
  unitCost      Float
  totalCost     Float
  minStockLevel Float              @default(0)
  maxStockLevel Float?
  reorderPoint  Float              @default(0)
  location      String?
  supplier      String?
  supplierId    String?
  status        String
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  supplierRel   Supplier?          @relation(fields: [supplierId], references: [id])
  categoryRel   InventoryCategory? @relation(fields: [categoryId], references: [id])
  site          Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  movements     StockMovement[]

  @@index([siteId])
  @@index([categoryId])
  @@index([supplierId])
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  quantity   Float
  change     Float
  type       String
  notes      String?
  createdAt  DateTime @default(now())
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
}

model InventoryCategory {
  id          String              @id @default(cuid())
  name        String
  description String?
  parentId    String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  parent      InventoryCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children    InventoryCategory[] @relation("SubCategories")
  materials   Material[]

  @@index([parentId])
}

model Equipment {
  id                  String    @id @default(cuid())
  siteId              String
  name                String
  type                String
  model               String?
  serialNo            String?
  condition           String?
  purchaseDate        DateTime?
  purchasePrice       Float?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  rentalCost          Float?
  dailyRate           Float?
  status              String    @default("idle")
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Document {
  id         String   @id @default(cuid())
  siteId     String
  name       String
  type       String
  fileUrl    String
  notes      String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Photo {
  id        String   @id @default(cuid())
  projectId String   @unique
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id             String    @id @default(cuid())
  siteId         String
  name           String
  company        String?
  purpose        String
  checkInTime    DateTime
  checkOutTime   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  attachmentName String?
  attachmentUrl  String?
  notes          String?
  site           Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Metric {
  id         String   @id @default(cuid())
  siteId     String
  type       String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([type])
}

model License {
  id               String    @id @default(cuid())
  siteId           String?
  name             String
  licenseNumber    String    @unique
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  type             String?
  category         String?
  status           String    @default("active")
  fileName         String?
  fileData         String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  site             Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  postalCode     String?
  website        String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  materials      Material[]
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  siteId               String?
  orderNumber          String              @unique
  supplierId           String
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               String              @default("pending")
  subtotal             Float               @default(0)
  tax                  Float               @default(0)
  total                Float               @default(0)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  site                 Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]

  @@index([supplierId])
  @@index([siteId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Float         @default(1)
  unitPrice       Float         @default(0)
  totalPrice      Float         @default(0)
  materialId      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model Wallet {
  id           String        @id @default(cuid())
  name         String
  description  String?
  balance      Float         @default(0)
  currency     String        @default("KES")
  status       String        @default("active")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

model Transaction {
  id              String   @id @default(cuid())
  walletId        String
  amount          Float
  type            String
  description     String?
  referenceNumber String?
  externalId      String?
  receiptNumber   String?
  status          String   @default("completed")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([type])
  @@index([externalId])
}

model SafetyIncident {
  id           String   @id @default(cuid())
  siteId       String
  title        String
  description  String
  type         String
  severity     String
  status       String   @default("Reported")
  incidentDate DateTime
  reportedBy   String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String     @id @default(cuid())
  contractorId String
  type         String
  emailEnabled Boolean    @default(true)
  pushEnabled  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, type])
}

model ActivityLog {
  id           String     @id @default(cuid())
  contractorId String
  userId       String
  action       String
  module       String
  description  String
  details      String?
  targetId     String?
  ipAddress    String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([userId])
  @@index([module])
}
