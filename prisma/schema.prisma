// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  role      String     // "superadmin" or "contractor"
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  contractor Contractor?
  sessions   Session[]
}

model Session {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([userId])
}

model Contractor {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  location    String     // Nairobi, Kisumu, Mombasa, etc.
  phoneNumber String
  licenseNo   String
  subscriptionPlanId String
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])
  safetyScore Float      @default(0)
  sites       Site[]
  team        TeamMember[]
  workers     Worker[]
  designations Designation[]
  payrollPeriods PayrollPeriod[]
  salaryComponents SalaryComponent[]
  salarySlips SalarySlip[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([subscriptionPlanId])
}

model Worker {
  id           String     @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  email        String?
  phone        String?
  nationalId   String?    @unique
  designationId String?
  designation  Designation? @relation(fields: [designationId], references: [id])
  status       String     @default("Active") // "Active", "Inactive", "Terminated"
  joinedAt     DateTime   @default(now())
  salarySlips  SalarySlip[]
  payrollPeriodsCreated PayrollPeriod[] @relation("CreatedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([contractorId])
  @@index([designationId])
}

model Designation {
  id          String   @id @default(cuid())
  contractorId String
  contractor  Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  title       String
  description String?
  salary      Float?
  paymentFrequency String?
  isActive    Boolean  @default(true)
  workers     Worker[]
  salarySlips SalarySlip[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contractorId])
}

model PayrollPeriod {
  id              String   @id @default(cuid())
  contractorId    String
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name            String
  startDate       DateTime
  endDate         DateTime
  paymentFrequency String?  @default("monthly") // "monthly", "weekly", "daily", "all"
  status          String   @default("draft") // "draft", "processing", "completed", "cancelled"
  description     String?
  totalEmployees  Int      @default(0)
  totalGrossPay   Float    @default(0)
  totalNetPay     Float    @default(0)
  totalDeductions Float    @default(0)
  createdByWorkerId String?
  createdBy       Worker?  @relation("CreatedBy", fields: [createdByWorkerId], references: [id], onDelete: SetNull)
  salarySlips     SalarySlip[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([contractorId])
  @@index([createdByWorkerId])
}

model SalaryComponent {
  id            String   @id @default(cuid())
  contractorId  String
  contractor    Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name          String
  type          String   // "earning", "deduction"
  deductionType String?  // "pre_tax", "post_tax", "employer_only"
  calculationType String // "fixed", "percentage"
  amount        Float?
  percentage    Float?
  isTaxable     Boolean  @default(true)
  isStatutory   Boolean  @default(false)
  isActive      Boolean  @default(true)
  description   String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([contractorId])
}

model SalarySlip {
  id                String   @id @default(cuid())
  contractorId      String
  contractor        Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  payrollPeriodId   String
  payrollPeriod     PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  workerId          String
  worker            Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  designationId     String?
  designation       Designation? @relation(fields: [designationId], references: [id])
  workingHours      Float    @default(0)
  attainedHours     Float    @default(0)
  workingDays       Int      @default(0)
  attainedDays      Int      @default(0)
  overtimeHours     Float    @default(0)
  lateHours         Float    @default(0)
  lateDays          Int      @default(0)
  leaveHours        Float    @default(0)
  leaveDays         Int      @default(0)
  basicSalary       Float    @default(0)
  totalAllowance    Float    @default(0)
  totalDeductions   Float    @default(0)
  grossPay          Float    @default(0)
  chargeableIncome  Float    @default(0)
  payeTax           Float    @default(0)
  personalRelief    Float    @default(0)
  netPay            Float    @default(0)
  employerCosts     Float    @default(0)
  status            String   @default("draft") // "draft", "processed", "paid", "cancelled"
  note              String?
  paymentMethod     String?
  phoneNumber       String?
  details           SalarySlipDetail[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([contractorId])
  @@index([payrollPeriodId])
  @@index([workerId])
  @@index([designationId])
}

model SalarySlipDetail {
  id                String   @id @default(cuid())
  salarySlipId      String
  salarySlip        SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)
  salaryComponentId String
  componentName     String
  componentType     String   // "earning", "deduction"
  deductionType     String?  // "pre_tax", "post_tax", "employer_only"
  isStatutory       Boolean  @default(false)
  amount            Float    @default(0)
  percentage        Float?
  calculationDetails String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([salarySlipId])
  @@index([salaryComponentId])
}

model SubscriptionPlan {
  id          String     @id @default(cuid())
  name        String     @unique // "Basic", "Professional", "Enterprise"
  price       Float
  maxSites    Int
  maxTeamMembers Int
  features    String     // JSON string of features
  isActive    Boolean    @default(true)
  contractors Contractor[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Site {
  id          String   @id @default(cuid())
  contractorId String
  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name        String
  location    String
  description String?
  isPrimary   Boolean  @default(false)
  materials   Material[]
  tasks       Task[]
  equipment   Equipment[]
  visitors    Visitor[]
  documents   Document[]
  licenses    License[]
  purchaseOrders PurchaseOrder[]
  metrics     Metric[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([contractorId])
}

model TeamMember {
  id           String   @id @default(cuid())
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  name         String
  role         String
  email        String?
  phone        String?
  status       String   @default("Active") // "On-Site", "Off-Duty", "Active", etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([contractorId])
}

model Task {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  title     String
  description String?
  status    String   // "pending", "in-progress", "completed"
  priority  String   // "low", "medium", "high"
  dueDate   DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([status])
}

model Material {
  id          String   @id @default(cuid())
  siteId      String
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sku         String?
  barcode     String?
  categoryId  String?
  categoryRel InventoryCategory? @relation(fields: [categoryId], references: [id])
  quantity    Float
  unit        String   // "bags", "tons", "cubic meters", "pieces"
  unitCost    Float
  totalCost   Float
  minStockLevel Float    @default(0)
  maxStockLevel Float?
  reorderPoint  Float    @default(0)
  location      String?
  supplier      String?  // Legacy or simple supplier name
  supplierId    String?
  supplierRel   Supplier? @relation(fields: [supplierId], references: [id])
  status      String   // "pending", "ordered", "received"
  notes       String?
  movements   StockMovement[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([siteId])
  @@index([categoryId])
  @@index([supplierId])
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quantity   Float    // The quantity after the movement or the change
  change     Float    // The change amount (+/-)
  type       String   // "in", "out", "adjustment"
  notes      String?
  createdAt  DateTime @default(now())

  @@index([materialId])
}

model InventoryCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  parent      InventoryCategory? @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children    InventoryCategory[] @relation("SubCategories")
  materials   Material[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
}

model Equipment {
  id                  String    @id @default(cuid())
  siteId              String
  site                Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String    // "Excavator", "Crane", "Concrete Mixer", etc.
  type                String
  model               String?
  serialNo            String?
  condition           String?   // "excellent", "good", "fair", "needs-repair"
  purchaseDate        DateTime?
  purchasePrice       Float?
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  rentalCost          Float?
  dailyRate           Float?
  status              String    @default("idle") // "in-use", "idle", "maintenance"
  notes               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([siteId])
}

model Document {
  id        String   @id @default(cuid())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  type      String   // "contract", "invoice", "report", "permit", "insurance"
  fileUrl   String
  notes     String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([siteId])
}

model Photo {
  id        String   @id @default(cuid())
  projectId String   @unique
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Visitor {
  id              String    @id @default(cuid())
  siteId          String
  site            Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name            String
  company         String?
  purpose         String    // "inspection", "meeting", "delivery", "other"
  checkInTime     DateTime
  checkOutTime    DateTime?
  notes           String?
  attachmentName  String?
  attachmentUrl   String?   // Can store base64 or a path
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([siteId])
}

model Metric {
  id         String   @id @default(cuid())
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  type       String   // "safety", "progress", "cost", "quality"
  value      Float
  unit       String   // "%", "KES", "days", etc.
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([siteId])
  @@index([type])
}

model License {
  id               String   @id @default(cuid())
  siteId           String?
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name             String
  licenseNumber    String   @unique
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  type             String?
  category         String?
  status           String   @default("active")
  fileName         String?
  fileData         String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([siteId])
}

model Supplier {
  id            String   @id @default(cuid())
  name          String
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  city          String?
  country       String?
  postalCode    String?
  website       String?
  notes         String?
  purchaseOrders PurchaseOrder[]
  materials     Material[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  siteId               String?
  site                 Site?               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  orderNumber          String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  status               String              @default("pending") // "pending", "completed", "cancelled"
  subtotal             Float               @default(0)
  tax                  Float               @default(0)
  total                Float               @default(0)
  notes                String?
  items                PurchaseOrderItem[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([supplierId])
  @@index([siteId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  quantity        Float         @default(1)
  unitPrice       Float         @default(0)
  totalPrice      Float         @default(0)
  materialId      String?       // Optional link to Material (inventory item)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([purchaseOrderId])
}

model Wallet {
  id          String        @id @default(cuid())
  name        String
  description String?
  balance     Float         @default(0)
  currency    String        @default("KES")
  status      String        @default("active")
  transactions Transaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Transaction {
  id              String   @id @default(cuid())
  walletId        String
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount          Float
  type            String   // "credit" or "debit"
  description     String?
  referenceNumber String?
  externalId      String?  // M-Pesa Request ID
  receiptNumber   String?  // M-Pesa Receipt Number
  status          String   @default("completed") // "pending", "completed", "failed"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([walletId])
  @@index([type])
  @@index([externalId])
}
