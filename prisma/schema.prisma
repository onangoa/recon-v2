generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password      String
  name          String
  role          String         @default("user") // superadmin, contractor, user
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contractor    Contractor?
  activityLogs  ActivityLog[]
  notifications Notification[]
  sessions      Session[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contractor {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  companyName             String
  location                String
  phoneNumber             String
  licenseNo               String
  logo                    String?
  subscriptionPlanId      String
  subscriptionStatus      String                   @default("active")
  subscriptionEndDate     DateTime?
  safetyScore             Float                    @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  subscriptionPlan        SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id])
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationPreferences NotificationPreference[]
  payrollPeriods          PayrollPeriod[]
  salaryComponents        SalaryComponent[]
  salarySlips             SalarySlip[]
  designations            Designation[]
  sites                   Site[]
  shifts                  Shift[]
  attendances             Attendance[]
  team                    TeamMember[]
  workers                 Worker[]
  activityLogs            ActivityLog[]
  projects                Project[]
  wallets                 Wallet[]

  @@index([subscriptionPlanId])
}

model Worker {
  id                    String          @id @default(cuid())
  contractorId          String
  name                  String
  email                 String?
  phone                 String?
  nationalId            String?         @unique
  enrollId              String?         @unique
  designationId         String?
  shiftId               String?
  status                String          @default("Active")
  joinedAt              DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  payrollPeriodsCreated PayrollPeriod[] @relation("CreatedBy")
  salarySlips           SalarySlip[]
  designation           Designation?    @relation(fields: [designationId], references: [id])
  shift                 Shift?          @relation(fields: [shiftId], references: [id])
  attendances           Attendance[]
  contractor            Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([designationId])
  @@index([shiftId])
}

model Shift {
  id            String       @id @default(cuid())
  contractorId  String
  name          String
  startTime     String // e.g., "08:00"
  endTime       String // e.g., "17:00"
  breakDuration Float        @default(0) // in minutes
  workingDays   String // comma separated: "Monday,Tuesday,Wednesday,Thursday,Friday"
  allowOvertime Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  contractor    Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workers       Worker[]
  attendances   Attendance[]

  @@index([contractorId])
}

model Attendance {
  id            String          @id @default(cuid())
  contractorId  String
  workerId      String
  shiftId       String?
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  totalHours    Float           @default(0)
  overtimeHours Float           @default(0)
  status        String          @default("Present") // Present, Absent, Late, Leave
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  logs          AttendanceLog[]
  worker        Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  shift         Shift?          @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  contractor    Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([contractorId])
  @@index([workerId])
  @@index([shiftId])
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendanceId String
  type         String // IN, OUT
  timestamp    DateTime
  deviceName   String?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model Designation {
  id               String       @id @default(cuid())
  contractorId     String
  title            String
  description      String?
  salary           Float?
  paymentFrequency String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  contractor       Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  salarySlips      SalarySlip[]
  workers          Worker[]

  @@index([contractorId])
}

model PayrollPeriod {
  id                String       @id @default(cuid())
  contractorId      String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            String       @default("draft")
  description       String?
  totalEmployees    Int          @default(0)
  totalGrossPay     Float        @default(0)
  totalNetPay       Float        @default(0)
  totalDeductions   Float        @default(0)
  paymentStatus     String       @default("pending")
  paymentFrequency  String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdByWorkerId String?
  contractor        Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  createdBy         Worker?      @relation("CreatedBy", fields: [createdByWorkerId], references: [id])
  salarySlips       SalarySlip[]

  @@index([contractorId])
  @@index([createdByWorkerId])
}

model SalaryComponent {
  id              String     @id @default(cuid())
  contractorId    String
  name            String
  type            String // earning, deduction
  description     String?
  amount          Float?
  isPercentage    Boolean    @default(false)
  percentage      Float?
  calculationType String?
  deductionType   String?
  isStatutory     Boolean    @default(false)
  isTaxable       Boolean    @default(true)
  sortOrder       Int        @default(0)
  isRecurring     Boolean    @default(true)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model SalarySlip {
  id               String              @id @default(cuid())
  contractorId     String
  workerId         String
  payrollPeriodId  String
  designationId    String?
  basicSalary      Float
  grossPay         Float
  netPay           Float
  totalDeductions  Float
  totalAllowance   Float               @default(0)
  overtimeHours    Float               @default(0)
  overtimePay      Float               @default(0)
  daysWorked       Int                 @default(0)
  workingDays      Int                 @default(0)
  attainedDays     Int                 @default(0)
  workingHours     Float               @default(0)
  attainedHours    Float               @default(0)
  lateDays         Int                 @default(0)
  lateHours        Float               @default(0)
  leaveDays        Int                 @default(0)
  leaveHours       Float               @default(0)
  payeTax          Float               @default(0)
  personalRelief   Float               @default(0)
  chargeableIncome Float               @default(0)
  employerCosts    Float               @default(0)
  paymentStatus    String              @default("pending") // pending, processing, paid, failed
  status           String?
  paymentDate      DateTime?
  mpesaReceipt     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  contractor       Contractor          @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  payrollPeriod    PayrollPeriod       @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  worker           Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  designation      Designation?        @relation(fields: [designationId], references: [id])
  details          SalarySlipDetail[]

  @@index([contractorId])
  @@index([workerId])
  @@index([payrollPeriodId])
  @@index([designationId])
}

model SalarySlipDetail {
  id           String     @id @default(cuid())
  salarySlipId String
  name         String
  type         String // earning, deduction
  amount       Float
  isStatutory  Boolean    @default(false)
  salarySlip   SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
}

model Project {
  id           String     @id @default(cuid())
  contractorId String
  name         String
  description  String?
  location     String
  status       String
  startDate    DateTime
  endDate      DateTime?
  budget       Float
  spent        Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@index([contractorId])
  @@index([status])
}

model Site {
  id              String           @id @default(cuid())
  projectId       String?
  contractorId    String
  name            String
  location        String
  coordinates     String?
  description     String?
  status          String           @default("Active")
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contractor      Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  tasks           Task[]
  visitors        VisitorLog[]
  safety          SafetyLog[]
  equipment       Equipment[]
  team            TeamMember[]
  inventory       Inventory[]
  licenses        License[]
  safetyIncidents SafetyIncident[]
  documents       Document[]
  metrics         Metric[]
  purchaseOrders  PurchaseOrder[]
  visitorEntities Visitor[]
  photos          Photo[]
  transfersFrom    StockTransfer[] @relation("TransferFrom")
  transfersTo      StockTransfer[] @relation("TransferTo")

  @@index([projectId])
  @@index([contractorId])
}

model TeamMember {
  id           String     @id @default(cuid())
  contractorId String
  siteId       String?
  name         String
  email        String?
  phone        String?
  role         String
  status       String     @default("Active")
  joinedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  site         Site?      @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([contractorId])
  @@index([siteId])
}

model Task {
  id          String    @id @default(cuid())
  siteId      String
  projectId   String? // Keep for backward compatibility if needed, but primary link is site
  title       String
  description String?
  status      String    @default("Pending") // Pending, In Progress, Completed
  priority    String    @default("Medium") // Low, Medium, High
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model VisitorLog {
  id           String    @id @default(cuid())
  siteId       String
  name         String
  phone        String?
  purpose      String
  hostName     String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Visitor {
  id           String    @id @default(cuid())
  siteId       String
  projectId    String? // Keep for seed compatibility
  name         String
  company      String?
  purpose      String
  checkInTime  DateTime
  checkOutTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SafetyLog {
  id          String   @id @default(cuid())
  siteId      String
  title       String
  description String
  severity    String // Low, Medium, High, Critical
  status      String   @default("Open") // Open, Resolved
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SafetyIncident {
  id           String   @id @default(cuid())
  siteId       String
  title        String
  description  String
  type         String
  severity     String
  status       String   @default("Reported")
  incidentDate DateTime
  reportedBy   String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Equipment {
  id           String    @id @default(cuid())
  siteId       String
  projectId    String? // Keep for seed compatibility
  name         String
  type         String
  serialNo     String?
  serialNumber String? // Keep for backward compatibility
  rentalCost   Float?
  dailyRate    Float?
  status       String    @default("Active") // Active, Maintenance, Repair, Out of Service
  lastService  DateTime?
  nextService  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Inventory {
  id           String             @id @default(cuid())
  siteId       String
  contractorId String?
  name         String
  description  String?
  sku          String?            @unique
  categoryId   String?
  quantity     Float              @default(0)
  unit         String
  minStock     Float              @default(0)
  location     String?
  status       String             @default("in-stock")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  site         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  category     InventoryCategory? @relation(fields: [categoryId], references: [id])
  transfers    StockTransfer[]
  movements    StockMovement[]

  @@index([siteId])
  @@index([categoryId])
}

model InventoryCategory {
  id            String              @id @default(cuid())
  parentId      String?
  name          String
  description   String?
  slug          String?             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  inventory     Inventory[]
  parent        InventoryCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories InventoryCategory[] @relation("SubCategories")

  @@index([parentId])
}

model License {
  id               String    @id @default(cuid())
  siteId           String?
  name             String
  licenseNumber    String    @unique
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  type             String?
  category         String?
  status           String    @default("active")
  fileName         String?
  fileData         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  site             Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model StockTransfer {
  id             String   @id @default(cuid())
  inventoryId    String
  fromSiteId     String
  toSiteId       String
  quantity       Float
  status         String   @default("pending") // pending, approved, rejected, completed
  requestedBy    String
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?
  rejectionReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  inventory      Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  fromSite       Site      @relation("TransferFrom", fields: [fromSiteId], references: [id], onDelete: Cascade)
  toSite         Site      @relation("TransferTo", fields: [toSiteId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([status])
}

model StockMovement {
  id           String   @id @default(cuid())
  inventoryId  String
  quantity     Float
  change       Float    // Positive for in, negative for out
  type         String   // in, out, adjustment
  notes        String?
  createdAt    DateTime @default(now())
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@index([type])
}

model Document {
  id         String   @id @default(cuid())
  siteId     String
  projectId  String? // Keep for seed compatibility
  name       String
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Photo {
  id        String   @id @default(cuid())
  siteId    String?
  projectId String?  @unique // Keep for seed compatibility
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Metric {
  id         String   @id @default(cuid())
  siteId     String
  projectId  String? // Keep for seed compatibility
  type       String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([type])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  siteId       String
  supplierId   String
  orderNumber  String              @unique
  status       String // pending, approved, completed, cancelled
  total        Float
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  site         Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items        PurchaseOrderItem[]

  @@index([siteId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Float
  unitPrice       Float
  totalPrice      Float
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model ActivityLog {
  id           String     @id @default(cuid())
  userId       String
  contractorId String
  action       String // CREATE, UPDATE, DELETE, etc.
  module       String // WORKERS, PAYROLL, INVENTORY, etc.
  description  String
  targetId     String?
  details      String? // JSON string
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([userId])
  @@index([module])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String // info, warning, error, success
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String     @id @default(cuid())
  contractorId String
  type         String // email, sms, push
  enabled      Boolean    @default(true) // backward compatibility
  emailEnabled Boolean    @default(true)
  pushEnabled  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@unique([contractorId, type])
}

model SubscriptionPlan {
  id             String       @id @default(cuid())
  name           String       @unique
  description    String?
  price          Float
  interval       String? // monthly, yearly
  maxProjects    Int?
  maxSites       Int? // Add for compatibility
  maxTeamMembers Int
  features       String // JSON string
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contractors    Contractor[]
}

model Wallet {
  id            String        @id @default(cuid())
  name          String
  description   String?
  balance       Float         @default(0)
  currency      String        @default("KES")
  status        String        @default("active") // active, inactive, frozen
  contractorId  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  contractor    Contractor    @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([contractorId])
}

model Transaction {
  id           String   @id @default(cuid())
  walletId     String
  amount       Float
  type         String // debit, credit
  description  String?
  status       String @default("completed") // pending, completed, failed
  reference    String?
  metadata     String?
  createdAt    DateTime @default(now())
  wallet       Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([createdAt])
}
