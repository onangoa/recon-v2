generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  role                String               @default("user")
  roleId              String?
  avatar              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activityLogs        ActivityLog[]
  contractor          Contractor?
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  teamMember          TeamMember?
  roleRelation        Role?                @relation(fields: [roleId], references: [id])
}

model Role {
  id           String       @id @default(cuid())
  name         String
  description  String?
  contractorId String?
  contractor   Contractor?  @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  teamMembers  TeamMember[]
  users        User[]
  permissions  Permission[] @relation("RolePermissions")

  @@index([contractorId])
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  module      String
  action      String
  description String?
  roles       Role[]  @relation("RolePermissions")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Contractor {
  id                      String                   @id @default(cuid())
  userId                  String                   @unique
  companyName             String
  location                String
  phoneNumber             String
  licenseNo               String
  logo                    String?
  subscriptionPlanId      String
  subscriptionStatus      String                   @default("active")
  subscriptionEndDate     DateTime?
  safetyScore             Float                    @default(0)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  activityLogs            ActivityLog[]
  attendances             Attendance[]
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan        SubscriptionPlan         @relation(fields: [subscriptionPlanId], references: [id])
  designations            Designation[]
  notificationPreferences NotificationPreference[]
  payrollPeriods          PayrollPeriod[]
  projects                Project[]
  roles                   Role[]
  salaryComponents        SalaryComponent[]
  salarySlips             SalarySlip[]
  shifts                  Shift[]
  sites                   Site[]
  team                    TeamMember[]
  wallets                 Wallet[]
  workers                 Worker[]

  @@index([subscriptionPlanId])
}

model Worker {
  id                    String          @id @default(cuid())
  contractorId          String
  name                  String
  email                 String?
  phone                 String?
  nationalId            String?         @unique
  designationId         String?
  shiftId               String?
  status                String          @default("Active")
  joinedAt              DateTime        @default(now())
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  enrollId              String?         @unique
  attendances           Attendance[]
  payrollPeriodsCreated PayrollPeriod[] @relation("CreatedBy")
  salarySlips           SalarySlip[]
  contractor            Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  shift                 Shift?          @relation(fields: [shiftId], references: [id])
  designation           Designation?    @relation(fields: [designationId], references: [id])

  @@index([contractorId])
  @@index([designationId])
  @@index([shiftId])
}

model Shift {
  id            String       @id @default(cuid())
  contractorId  String
  name          String
  startTime     String
  endTime       String
  breakDuration Float        @default(0)
  workingDays   String
  allowOvertime Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  attendances   Attendance[]
  contractor    Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  workers       Worker[]

  @@index([contractorId])
}

model Attendance {
  id            String          @id @default(cuid())
  contractorId  String
  workerId      String
  shiftId       String?
  date          DateTime
  checkIn       DateTime?
  checkOut      DateTime?
  totalHours    Float           @default(0)
  overtimeHours Float           @default(0)
  status        String          @default("Present")
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  contractor    Contractor      @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  shift         Shift?          @relation(fields: [shiftId], references: [id])
  worker        Worker          @relation(fields: [workerId], references: [id], onDelete: Cascade)
  logs          AttendanceLog[]

  @@unique([workerId, date])
  @@index([contractorId])
  @@index([workerId])
  @@index([shiftId])
}

model AttendanceLog {
  id           String     @id @default(cuid())
  attendanceId String
  type         String
  timestamp    DateTime
  deviceName   String?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model Designation {
  id               String       @id @default(cuid())
  contractorId     String
  title            String
  description      String?
  salary           Float?
  paymentFrequency String?
  isActive         Boolean      @default(true)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  contractor       Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  salarySlips      SalarySlip[]
  workers          Worker[]

  @@index([contractorId])
}

model PayrollPeriod {
  id                String       @id @default(cuid())
  contractorId      String
  name              String
  startDate         DateTime
  endDate           DateTime
  status            String       @default("draft")
  description       String?
  totalEmployees    Int          @default(0)
  totalGrossPay     Float        @default(0)
  totalNetPay       Float        @default(0)
  totalDeductions   Float        @default(0)
  paymentStatus     String       @default("pending")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdByWorkerId String?
  paymentFrequency  String?
  createdBy         Worker?      @relation("CreatedBy", fields: [createdByWorkerId], references: [id])
  contractor        Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  salarySlips       SalarySlip[]

  @@index([contractorId])
  @@index([createdByWorkerId])
}

model SalaryComponent {
  id              String     @id @default(cuid())
  contractorId    String
  name            String
  type            String
  description     String?
  amount          Float?
  isPercentage    Boolean    @default(false)
  percentage      Float?
  calculationType String?
  deductionType   String?
  isStatutory     Boolean    @default(false)
  isTaxable       Boolean    @default(true)
  sortOrder       Int        @default(0)
  isRecurring     Boolean    @default(true)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  contractor      Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model SalarySlip {
  id               String             @id @default(cuid())
  contractorId     String
  workerId         String
  payrollPeriodId  String
  designationId    String?
  basicSalary      Float
  grossPay         Float
  netPay           Float
  totalDeductions  Float
  totalAllowance   Float              @default(0)
  overtimeHours    Float              @default(0)
  overtimePay      Float              @default(0)
  daysWorked       Int                @default(0)
  workingDays      Int                @default(0)
  attainedDays     Int                @default(0)
  workingHours     Float              @default(0)
  attainedHours    Float              @default(0)
  lateDays         Int                @default(0)
  lateHours        Float              @default(0)
  leaveDays        Int                @default(0)
  leaveHours       Float              @default(0)
  payeTax          Float              @default(0)
  personalRelief   Float              @default(0)
  chargeableIncome Float              @default(0)
  employerCosts    Float              @default(0)
  paymentStatus    String             @default("pending")
  status           String?
  paymentDate      DateTime?
  mpesaReceipt     String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  designation      Designation?       @relation(fields: [designationId], references: [id])
  worker           Worker             @relation(fields: [workerId], references: [id], onDelete: Cascade)
  payrollPeriod    PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  contractor       Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  details          SalarySlipDetail[]

  @@index([contractorId])
  @@index([workerId])
  @@index([payrollPeriodId])
  @@index([designationId])
}

model SalarySlipDetail {
  id           String     @id @default(cuid())
  salarySlipId String
  name         String
  type         String
  amount       Float
  isStatutory  Boolean    @default(false)
  salarySlip   SalarySlip @relation(fields: [salarySlipId], references: [id], onDelete: Cascade)

  @@index([salarySlipId])
}

model Project {
  id           String     @id @default(cuid())
  contractorId String
  name         String
  description  String?
  location     String
  status       String
  startDate    DateTime
  endDate      DateTime?
  budget       Float
  spent        Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  sites        Site[]

  @@index([contractorId])
  @@index([status])
}

model Site {
  id              String           @id @default(cuid())
  projectId       String?
  contractorId    String
  name            String
  location        String
  coordinates     String?
  description     String?
  status          String           @default("Active")
  isPrimary       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  documents       Document[]
  equipment       Equipment[]
  inventory       Inventory[]
  licenses        License[]
  metrics         Metric[]
  photos          Photo[]
  purchaseOrders  PurchaseOrder[]
  safetyIncidents SafetyIncident[]
  safety          SafetyLog[]
  contractor      Contractor       @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transfersTo     StockTransfer[]  @relation("TransferTo")
  transfersFrom   StockTransfer[]  @relation("TransferFrom")
  tasks           Task[]
  team            TeamMember[]
  visitorEntities Visitor[]
  visitors        VisitorLog[]

  @@index([projectId])
  @@index([contractorId])
}

model TeamMember {
  id           String     @id @default(cuid())
  contractorId String
  userId       String?    @unique
  siteId       String?
  name         String
  email        String?
  phone        String?
  roleId       String?
  role         String
  status       String     @default("Active")
  joinedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  site         Site?      @relation(fields: [siteId], references: [id])
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  roleRelation Role?      @relation(fields: [roleId], references: [id])
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([siteId])
  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  siteId      String
  title       String
  description String?
  status      String    @default("Pending")
  priority    String    @default("Medium")
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projectId   String?
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model VisitorLog {
  id           String    @id @default(cuid())
  siteId       String
  name         String
  phone        String?
  purpose      String
  hostName     String
  checkInTime  DateTime  @default(now())
  checkOutTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Visitor {
  id           String    @id @default(cuid())
  siteId       String
  projectId    String?
  name         String
  company      String?
  purpose      String
  checkInTime  DateTime
  checkOutTime DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SafetyLog {
  id          String   @id @default(cuid())
  siteId      String
  title       String
  description String
  severity    String
  status      String   @default("Open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  site        Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model SafetyIncident {
  id           String   @id @default(cuid())
  siteId       String
  title        String
  description  String
  type         String
  severity     String
  status       String   @default("Reported")
  incidentDate DateTime
  reportedBy   String
  attachments  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Equipment {
  id           String    @id @default(cuid())
  siteId       String
  projectId    String?
  name         String
  type         String
  serialNo     String?
  serialNumber String?
  rentalCost   Float?
  dailyRate    Float?
  status       String    @default("Active")
  lastService  DateTime?
  nextService  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  site         Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Inventory {
  id           String             @id @default(cuid())
  siteId       String
  contractorId String?
  name         String
  description  String?
  sku          String?            @unique
  categoryId   String?
  quantity     Float              @default(0)
  unitCost     Float              @default(0)
  unit         String
  minStock     Float              @default(0)
  location     String?
  status       String             @default("in-stock")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  category     InventoryCategory? @relation(fields: [categoryId], references: [id])
  site         Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  movements    StockMovement[]
  transfers    StockTransfer[]

  @@index([siteId])
  @@index([categoryId])
}

model InventoryCategory {
  id            String              @id @default(cuid())
  parentId      String?
  name          String
  description   String?
  slug          String?             @unique
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  inventory     Inventory[]
  parent        InventoryCategory?  @relation("SubCategories", fields: [parentId], references: [id])
  subCategories InventoryCategory[] @relation("SubCategories")

  @@index([parentId])
}

model License {
  id               String    @id @default(cuid())
  siteId           String?
  name             String
  licenseNumber    String    @unique
  issuingAuthority String?
  issueDate        DateTime?
  expiryDate       DateTime?
  type             String?
  category         String?
  status           String    @default("active")
  fileName         String?
  fileData         String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  site             Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model StockTransfer {
  id              String    @id @default(cuid())
  inventoryId     String
  fromSiteId      String
  toSiteId        String
  quantity        Float
  status          String    @default("pending")
  requestedBy     String
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  toSite          Site      @relation("TransferTo", fields: [toSiteId], references: [id], onDelete: Cascade)
  fromSite        Site      @relation("TransferFrom", fields: [fromSiteId], references: [id], onDelete: Cascade)
  inventory       Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([fromSiteId])
  @@index([toSiteId])
  @@index([status])
}

model StockMovement {
  id          String    @id @default(cuid())
  inventoryId String
  quantity    Float
  change      Float
  type        String
  notes       String?
  createdAt   DateTime  @default(now())
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([inventoryId])
  @@index([createdAt])
  @@index([type])
}

model Document {
  id         String   @id @default(cuid())
  siteId     String
  projectId  String?
  name       String
  type       String
  fileUrl    String
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Photo {
  id        String   @id @default(cuid())
  siteId    String?
  projectId String?  @unique
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  site      Site?    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Metric {
  id         String   @id @default(cuid())
  siteId     String
  projectId  String?
  type       String
  value      Float
  unit       String
  recordedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  site       Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
  @@index([type])
}

model Supplier {
  id             String          @id @default(cuid())
  name           String
  contactPerson  String?
  email          String?
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id                   String              @id @default(cuid())
  siteId               String
  supplierId           String
  orderNumber          String              @unique
  status               String
  subtotal             Float               @default(0)
  tax                  Float               @default(0)
  total                Float               @default(0)
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  supplier             Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  site                 Site                @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items                PurchaseOrderItem[]

  @@index([siteId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  description     String
  quantity        Float
  unitPrice       Float
  totalPrice      Float
  materialId      String?
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model ActivityLog {
  id           String     @id @default(cuid())
  userId       String
  contractorId String
  action       String
  module       String
  description  String
  targetId     String?
  details      String?
  createdAt    DateTime   @default(now())
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contractorId])
  @@index([userId])
  @@index([module])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  link      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationPreference {
  id           String     @id @default(cuid())
  contractorId String
  type         String
  enabled      Boolean    @default(true)
  emailEnabled Boolean    @default(true)
  pushEnabled  Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([contractorId, type])
  @@index([contractorId])
}

model SubscriptionPlan {
  id             String       @id @default(cuid())
  name           String       @unique
  description    String?
  price          Float
  interval       String?
  maxProjects    Int?
  maxSites       Int?
  maxTeamMembers Int
  features       String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  contractors    Contractor[]
}

model Wallet {
  id           String        @id @default(cuid())
  name         String
  description  String?
  balance      Float         @default(0)
  currency     String        @default("KES")
  status       String        @default("active")
  contractorId String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
  contractor   Contractor    @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@index([contractorId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Transaction {
  id                        String   @id @default(cuid())
  walletId                  String
  amount                    Float
  type                      String
  description               String?
  status                    String   @default("completed")
  reference                 String?
  receiptNumber             String?
  externalId                String?
  metadata                  String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  wallet                    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // M-Pesa specific fields
  mpesaTransactionId        String?
  merchantRequestId         String?
  checkoutRequestId         String?
  originatorConversationId  String?
  conversationId            String?
  transactionType           String?
  resultCode                Int?
  resultDesc                String?
  mpesaReceiptNumber        String?
  accountReference          String?
  transactionDesc           String?
  remarks                   String?
  phoneNumber               String?
  rawCallbackData           String?
  rawApiResponse            String?
  callbackReceivedAt        DateTime?

  @@index([walletId])
  @@index([createdAt])
  @@index([externalId])
  @@index([mpesaTransactionId])
  @@index([checkoutRequestId])
  @@index([merchantRequestId])
  @@index([conversationId])
  @@index([originatorConversationId])
  @@index([status])
  @@index([transactionType])
}
